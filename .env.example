
# SEC EDGAR User-Agent (SEC requires a descriptive UA on every request)
SEC_USER_AGENT=

# Hugging Face token (optional, for faster model downloads)
HF_TOKEN=

# LLM backend: "llama_cpp", "llama_server" (local Docker), "anthropic", or "openai"
LLM_BACKEND=llama_cpp

# For llama_server, serve a model at http://127.0.0.1:8080/v1.
# If unset, the first model returned by /v1/models is selected.
# This backend never contacts a cloud API or falls back to an in-process model.
# LLAMA_SERVER_MODEL=rve-local
LLAMA_SERVER_TIMEOUT=300

# Path to local GGUF model (required for llama_cpp backend)
# Supports env vars (%USERPROFILE% on Windows, $HOME on Linux/macOS)
LLAMA_CPP_MODEL_PATH=
# CPU-safe defaults. Set GPU layers only after confirming a compatible GPU build and enough VRAM.
LLAMA_CPP_N_GPU_LAYERS=0
LLAMA_CPP_N_BATCH=32
LLAMA_CPP_N_CTX=8192
# API keys for cloud backends (only needed if LLM_BACKEND=anthropic or openai)
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# OPENAI_API_KEY=sk-xxxxx

# --- RAG Config (all optional — sensible defaults below) ---

# Bi-encoder retrieval
RAG_TOP_K=5
RAG_MIN_RELEVANCE=0.3
RAG_N_CANDIDATES=50

# Query expansion (glossary synonyms)
RAG_EXPANSION_ENABLED=true
RAG_EXPANSION_N_TERMS=5

# Cross-encoder re-ranking
RAG_CROSS_ENCODER_ENABLED=true
RAG_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_CROSS_ENCODER_DEVICE=cpu
RAG_CROSS_ENCODER_BATCH_SIZE=32
RAG_CROSS_ENCODER_WEIGHT=0.7

# Embedding model device
EMBEDDING_DEVICE=cpu

# Forward-looking statement penalty
RAG_FORWARD_LOOKING_PENALTY_ENABLED=true
RAG_FORWARD_LOOKING_PENALTY_WEIGHT=-0.15

# Keyword boosting (works alongside cross-encoder)
RAG_KEYWORD_BOOST_ENABLED=true
RAG_KEYWORD_BOOST_WEIGHT=0.15

# LLM generation
RAG_LLM_MAX_TOKENS=4096
RAG_LLM_TEMPERATURE=0.1

# ChromaDB storage
CHROMA_DB_PATH=./chroma_db
